{
  "name": "smartbots-platform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "dev": "pnpm --filter @smartbots/shared build && pnpm -r --parallel --filter @smartbots/api --filter @smartbots/web dev",
    "dev:web": "pnpm --filter @smartbots/shared build && pnpm --filter @smartbots/web dev",
    "dev:api": "pnpm --filter @smartbots/shared build && pnpm --filter @smartbots/api dev",
    "build": "pnpm -r build",
    "build:web": "pnpm --filter @smartbots/web build",
    "preview:web": "pnpm --filter @smartbots/web preview",
    "export:html": "pnpm --filter @smartbots/web export:html",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
